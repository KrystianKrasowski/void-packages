# Template file for 'kotlin-lsp-bin'
pkgname=kotlin-lsp-bin
version=263.4702.0
revision=1
short_desc="Kotlin LSP server"
maintainer="Krystian Krasowski <krystiankrasowski@gmail.com>"
license="GFDL-1.2-or-later, GPL-3.0-or-later, LGPL-2.1-or-later"
homepage="https://github.com/Kotlin/kotlin-lsp"
distfiles="https://download.jetbrains.com/language-server/kotlin-server/263.4702.0/kotlin-server-263.4702.0.tar.gz"
checksum=1e11d2e5fefbf9ea215ad8dd6be95f2222897cd086e8cb7a661a52084a590405

#nopie=yes
#nostrip=yes
noverifyrdeps=yes

do_install() {
	vmkdir /opt/jetbrains/kotlin-lsp

	vcopy * /opt/jetbrains/kotlin-lsp

	# need to apply executable rights to all bin files
	vinstall kotlin-lsp.sh 755 /opt/jetbrains/kotlin-lsp

	vinstall jbr/bin/java 755 /opt/jetbrains/kotlin-lsp/jbr/bin
	vinstall jbr/bin/javac 755 /opt/jetbrains/kotlin-lsp/jbr/bin
	vinstall jbr/bin/javadoc 755 /opt/jetbrains/kotlin-lsp/jbr/bin
	vinstall jbr/bin/jcmd 755 /opt/jetbrains/kotlin-lsp/jbr/bin
	vinstall jbr/bin/jdb 755 /opt/jetbrains/kotlin-lsp/jbr/bin
	vinstall jbr/bin/jfr 755 /opt/jetbrains/kotlin-lsp/jbr/bin
	vinstall jbr/bin/jhsdb 755 /opt/jetbrains/kotlin-lsp/jbr/bin
	vinstall jbr/bin/jinfo 755 /opt/jetbrains/kotlin-lsp/jbr/bin
	vinstall jbr/bin/jmap 755 /opt/jetbrains/kotlin-lsp/jbr/bin
	vinstall jbr/bin/jps 755 /opt/jetbrains/kotlin-lsp/jbr/bin
	vinstall jbr/bin/jrunscript 755 /opt/jetbrains/kotlin-lsp/jbr/bin
	vinstall jbr/bin/jstack 755 /opt/jetbrains/kotlin-lsp/jbr/bin
	vinstall jbr/bin/jstat 755 /opt/jetbrains/kotlin-lsp/jbr/bin
	vinstall jbr/bin/jwebserver 755 /opt/jetbrains/kotlin-lsp/jbr/bin
	vinstall jbr/bin/keytool 755 /opt/jetbrains/kotlin-lsp/jbr/bin
	vinstall jbr/bin/rmiregistry 755 /opt/jetbrains/kotlin-lsp/jbr/bin
	vinstall jbr/bin/serialver 755 /opt/jetbrains/kotlin-lsp/jbr/bin

	vinstall bin/intellij-server 755 /opt/jetbrains/kotlin-lsp/bin
}
